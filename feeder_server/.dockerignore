# --- Deepfeeder runtime persistence (never include in build context) ---
# We persist Parquet and DuckDB under feeder_server/data/persistence at runtime via bind mounts.
# Exclude these from the Docker build context to avoid accidental COPY into the image.
data/persistence/
data/persistence/**

__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl
*.db
*.sqlite3
*.log
*.egg-info/
*.env
*.venv
*.DS_Store
*.idea/
*.pytest_cache/
*.coverage
*.mypy_cache/
*.tox/
*.dist-info/
*.egg
*.zip
*.tar.gz
*.whl
*.bak
*.swp
*.tmp
*.orig
*.out
*.pid
*.pid.lock
*.coverage.*

# General VCS/editor noise
.git/
.vscode/

# Columnar and DB artifacts (avoid accidental inclusion)
*.parquet
*.duckdb
*.duckdb.wal
