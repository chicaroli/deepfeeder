#############################################
# DeepFeeder Environment Defaults (.env.example)
# Copy to .env and adjust as needed. All have sane defaults.
#############################################

# Deephaven server connection (client side usage)
DEEPHAVEN_HOST=deephaven
DEEPHAVEN_PORT=10000

# Application autostart / UI registration
DEEPFEEDER_REGISTER_UI=1
DEEPFEEDER_AUTOSTART=1

# Global heartbeat supervisor interval (seconds)
DEEPFEEDER_HEARTBEAT_INTERVAL=5

# Fanout (core + per-symbol listener) heartbeat min meta update intervals
DEEPFEEDER_FANOUT_CORE_HEARTBEAT_MIN_INTERVAL=5
DEEPFEEDER_FANOUT_LISTENER_HEARTBEAT_MIN_INTERVAL=2

## Optional Binance feeder overrides (defaults defined in feeders/binance/config.py)
# DEEPFEEDER_BINANCE_BATCH_SIZE=400
# DEEPFEEDER_BINANCE_FLUSH_INTERVAL_S=0.1
# DEEPFEEDER_BINANCE_METRICS_ENABLED=1
# DEEPFEEDER_BINANCE_METRICS_INTERVAL=60
# DEEPFEEDER_BINANCE_METRICS_MIN_Q_DELTA=500

## Optional TradingView feeder overrides (defaults in feeders/tradingview/config.py)
# DEEPFEEDER_TV_BATCH_SIZE=200
# DEEPFEEDER_TV_FLUSH_INTERVAL_S=0.25
# DEEPFEEDER_TV_METRICS_ENABLED=1
# DEEPFEEDER_TV_METRICS_INTERVAL=60
# DEEPFEEDER_TV_METRICS_MIN_Q_DELTA=200

# PYTHONPATH for feeder_client (client container)
PYTHONPATH=feeder_client/src
## (Binance overrides duplicated above; remove duplicates if uncommented)

